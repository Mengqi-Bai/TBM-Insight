# Copy to test.env; paths in secret configuration resolve beside macos-signing.env.
TBM_ENGINE_DESKTOP_APP_ID=com.deepseek.tbm
TBM_ENGINE_DESKTOP_AUTO_UPDATE_ENV=test
TBM_ENGINE_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
TBM_ENGINE_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
DOWNLOAD_TEST_ORIGIN=
# Generate a 32-character lowercase hexadecimal release ID; retain it for upgrade testing.
DOWNLOAD_TEST_RELEASE_ID=
TBM_ENGINE_DESKTOP_MACOS_PACK_CONCURRENCY=4
TBM_ENGINE_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
TBM_ENGINE_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Temporarily changes the active network service's system HTTP/HTTPS proxies.
TBM_ENGINE_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# TBM_ENGINE_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
