# Copy to production.env in the same machine configuration directory and fill in the values.
TBM_ENGINE_DESKTOP_APP_ID=com.deepseek.tbm
TBM_ENGINE_DESKTOP_AUTO_UPDATE_ENV=production
TBM_ENGINE_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
TBM_ENGINE_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# TBM_ENGINE_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
TBM_ENGINE_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
TBM_ENGINE_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
