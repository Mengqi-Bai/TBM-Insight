{
  "name": "@tbm-insight/session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-persistence": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session-format": "workspace:*",
    "@tbm-insight/session-format-catalog": "workspace:*",
    "@tbm-insight/session-format-v3-to-v4": "workspace:*",
    "@tbm-insight/node-addon-system": "workspace:~",
    "@tbm-insight/schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-format-v0-to-v1": "workspace:*",
    "@tbm-insight/session-persistence": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
