{
  "name": "@tbm-insight/session-telemetry-otel",
  "description": "Feedback-authorized Session logs over byte-bounded OpenTelemetry HTTP requests",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api-logs": "0.222.0",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/command-feedback": "workspace:*",
    "@tbm-insight/message-feedback": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-telemetry": "workspace:*",
    "@tbm-insight/anonymous-user-id": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/otel": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis-plugin-logger-console": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/bash-local": "workspace:*",
    "@tbm-insight/command-feedback": "workspace:*",
    "@tbm-insight/message-feedback": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/loader-smoke": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-checkpoint-policy": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/session-telemetry": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/anonymous-user-id": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/http-proxy": "workspace:*",
    "@tbm-insight/otel": "workspace:*"
  }
}
