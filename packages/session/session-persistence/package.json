{
  "name": "@tbm-insight/session-persistence",
  "description": "Abstract durable session persistence seam (ctx.sessionPersistence) for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/util-values": "workspace:*"
  }
}
