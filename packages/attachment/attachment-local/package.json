{
  "name": "@tbm-insight/attachment-local",
  "description": "Private content-addressed TBM_ENGINE_HOME attachment storage",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/home-paths": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/lazy-require": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/home-paths": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
