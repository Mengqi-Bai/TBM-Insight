{
  "name": "@tbm-insight/fs-local",
  "description": "Local-filesystem implementation of the TBM Insight filesystem seam (ctx.fs)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@tbm-insight/schemastery": "workspace:~",
    "@tbm-insight/fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
