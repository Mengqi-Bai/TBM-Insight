{
  "name": "@tbm-insight/fs",
  "description": "Abstract filesystem capability seam (ctx.fs) for the TBM Insight — vocabulary types, the FileSystem service (text IO + optional version-guarded atomic mutations), and the fs/* policy event vocabulary",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/fs-patch": "workspace:*"
  }
}
