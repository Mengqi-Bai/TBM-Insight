{
  "name": "@tbm-insight/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/output-retention": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/output-retention": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*"
  }
}
