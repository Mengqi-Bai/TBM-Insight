{
  "name": "@tbm-insight/terminal-bash",
  "description": "Persistent shell PTY backend over the TBM Insight subprocess terminal primitive",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/terminal": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/lazy-require": "workspace:*",
    "@tbm-insight/pwsh-local": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/terminal": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  }
}
