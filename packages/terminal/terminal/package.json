{
  "name": "@tbm-insight/terminal",
  "description": "Persistent PTY session seam for the TBM Insight — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
