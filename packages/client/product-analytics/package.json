{
  "name": "@tbm-insight/client-product-analytics",
  "description": "Desktop product event collection and authenticated Host reporting",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/events.d.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/api-gateway": "workspace:*",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/host-product-telemetry-otel": "workspace:*",
    "@tbm-insight/deepseek-account": "workspace:*",
    "@tbm-insight/host-webserver": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/otel": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/loader-smoke": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3"
  }
}
