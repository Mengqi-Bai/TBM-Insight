{
  "name": "@tbm-insight/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/api-workspace-controller",
        "@tbm-insight/client-connection",
        "@tbm-insight/client-locale",
        "@tbm-insight/client-ui-conversation",
        "@tbm-insight/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/spill-policy": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-jobs": "workspace:*",
    "@tbm-insight/tool-session-query": "workspace:*",
    "@tbm-insight/tool-terminal": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/api-remotes": "workspace:*",
    "@tbm-insight/client-connection": "workspace:*",
    "@tbm-insight/client-locale": "workspace:*",
    "@tbm-insight/client-test-runtime": "workspace:*",
    "@tbm-insight/client-ui-conversation": "workspace:*",
    "@tbm-insight/client-ui-primitives": "workspace:*",
    "@tbm-insight/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tbm-insight/api-workspace-controller": "workspace:*",
    "@tbm-insight/client-ui-chat": "workspace:*",
    "@tbm-insight/client-ui-renderer": "workspace:*",
    "@tbm-insight/client-ui-session": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/util-workspace-path": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/token-meter": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/client-ui-context-menu": "workspace:*",
    "@tbm-insight/api-session-controller": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
