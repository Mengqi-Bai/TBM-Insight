{
  "name": "@tbm-insight/client-hmr",
  "description": "Web client graph synchronization and rebuilt-bundle reload transport",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/client-modules"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/client-modules": "workspace:*",
    "@tbm-insight/host-webserver": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "eventsource-parser": "^3.1.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
