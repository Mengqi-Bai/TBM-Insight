{
  "name": "@tbm-insight/client-ui-settings-web-search",
  "description": "Settings page for web search and fetch on the tbm web client's Plugins page: the Search and Fetch provider menus, the DeepSeek Search API result count, and legacy Messages search settings",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/client-locale",
        "@tbm-insight/client-ui-settings",
        "@tbm-insight/client-ui-plugin-manager",
        "@tbm-insight/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/api-remotes": "workspace:*",
    "@tbm-insight/client-locale": "workspace:*",
    "@tbm-insight/client-store": "workspace:*",
    "@tbm-insight/client-test-runtime": "workspace:*",
    "@tbm-insight/client-ui-plugin-manager": "workspace:*",
    "@tbm-insight/client-ui-primitives": "workspace:*",
    "@tbm-insight/client-ui-renderer": "workspace:*",
    "@tbm-insight/client-ui-settings": "workspace:*",
    "@tbm-insight/client-ui-slots": "workspace:*",
    "@tbm-insight/web": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
