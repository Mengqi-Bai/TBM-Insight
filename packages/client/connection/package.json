{
  "name": "@tbm-insight/client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/scope": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/host-webserver": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*"
  }
}
