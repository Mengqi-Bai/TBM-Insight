{
  "name": "@tbm-insight/client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/api-remotes",
        "@tbm-insight/client-connection",
        "@tbm-insight/client-locale",
        "@tbm-insight/client-ui-chat",
        "@tbm-insight/client-ui-conversation",
        "@tbm-insight/client-ui-renderer",
        "@tbm-insight/client-ui-sidebar-right",
        "@tbm-insight/client-ui-tool",
        "@tbm-insight/client-ui-settings",
        "@tbm-insight/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/api-remotes": "workspace:*",
    "@tbm-insight/client-connection": "workspace:*",
    "@tbm-insight/client-locale": "workspace:*",
    "@tbm-insight/client-store": "workspace:*",
    "@tbm-insight/client-test-runtime": "workspace:*",
    "@tbm-insight/client-ui-chat": "workspace:*",
    "@tbm-insight/client-ui-conversation": "workspace:*",
    "@tbm-insight/client-ui-dockkit": "workspace:*",
    "@tbm-insight/client-ui-renderer": "workspace:*",
    "@tbm-insight/client-ui-sidebar-right": "workspace:*",
    "@tbm-insight/client-ui-slots": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "react": "^18.2.0",
    "@tbm-insight/client-ui-primitives": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/session-query": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/client-ui-tool": "workspace:*",
    "@tbm-insight/tool-present": "workspace:*",
    "@tbm-insight/workspace-changes": "workspace:*",
    "@tbm-insight/api-session-controller": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/util-workspace-path": "workspace:*",
    "@tbm-insight/api-workspace-files": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/client-ui-settings": "workspace:*",
    "@tbm-insight/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@tbm-insight/typert-protocol": "workspace:*"
  }
}
