{
  "name": "@tbm-insight/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@tbm-insight/deque": "workspace:*",
    "@tbm-insight/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/scope": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-preset-registry": "workspace:*",
    "@tbm-insight/api-gateway": "workspace:*",
    "@tbm-insight/api-job-controller": "workspace:*",
    "@tbm-insight/api-session-controller": "workspace:*",
    "@tbm-insight/api-settings-controller": "workspace:*",
    "@tbm-insight/api-workspace-controller": "workspace:*",
    "@tbm-insight/api-workspace-files": "workspace:*",
    "@tbm-insight/client-connection": "workspace:*",
    "@tbm-insight/client-file-upload": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/cordis-host-runner": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/file-reference": "workspace:*",
    "@tbm-insight/goal": "workspace:*",
    "@tbm-insight/host-plugin-inventory": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/message-feedback": "workspace:*",
    "@tbm-insight/permission-presets": "workspace:*",
    "@tbm-insight/schedule": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-reference": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "zod": "4.4.3",
    "@tbm-insight/command-feedback": "workspace:*",
    "@tbm-insight/api-terminal-controller": "workspace:*",
    "@tbm-insight/plugin-manager": "workspace:*",
    "@tbm-insight/mcp-manager": "workspace:*",
    "@tbm-insight/plugin-market": "workspace:*",
    "@tbm-insight/client-ui-plugin-manager": "workspace:*",
    "@tbm-insight/office-to-pdf": "workspace:*",
    "@tbm-insight/api-account-controller": "workspace:*",
    "@tbm-insight/deepseek-account": "workspace:*",
    "@tbm-insight/client-product-analytics": "workspace:*",
    "@tbm-insight/agent-team": "workspace:*",
    "@tbm-insight/client-ui-trajectory": "workspace:*",
    "@tbm-insight/web": "workspace:*"
  }
}
