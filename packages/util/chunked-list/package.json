{
  "name": "@tbm-insight/chunked-list",
  "description": "Persistent append-only chunked lists with bounded copying and JSON checkpoint validation",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
