{
  "name": "@tbm-insight/tool-call-timeout-policy",
  "description": "Tool-call timeout policy: a tools/execute wrapper that arms a per-tool deadline on exec.signal and returns TOOL_TIMEOUT when it wins",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
