{
  "name": "@tbm-insight/session-snapshot",
  "description": "Session-log snapshot core with an ACP protocol adapter, expected-output normalization, and fixture invariants",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/llm-replay": "workspace:*",
    "@tbm-insight/loader-smoke": "workspace:*",
    "@tbm-insight/session-format": "workspace:*",
    "js-yaml": "^4.3.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/http-proxy": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/agent-preset-registry": "workspace:*",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@tbm-insight/http-proxy": "workspace:*"
  }
}
