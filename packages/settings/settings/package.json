{
  "name": "@tbm-insight/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@tbm-insight/cordis-plugin-timer": "workspace:~",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/hmr": "workspace:*",
    "@tbm-insight/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/config-editor": "workspace:*",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
