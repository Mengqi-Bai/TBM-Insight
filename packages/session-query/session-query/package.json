{
  "name": "@tbm-insight/session-query",
  "description": "Combined session query service contract with concrete reads, traces, and filters",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-title": "workspace:*",
    "@tbm-insight/tool-todo": "workspace:*",
    "@tbm-insight/session-persistence": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/session-projection-cache": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/session-persistence": {
      "optional": true
    },
    "@tbm-insight/session-projection": {
      "optional": true
    },
    "@tbm-insight/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-title": "workspace:*",
    "@tbm-insight/tool-todo": "workspace:*",
    "@tbm-insight/session-persistence": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/session-projection-cache": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/session-format-catalog": "workspace:*"
  }
}
