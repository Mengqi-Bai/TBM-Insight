{
  "name": "@tbm-insight/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "tbm": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/sdk-protocol": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@tbm-insight/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/loader-smoke": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-checkpoint-policy": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-jobs": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
