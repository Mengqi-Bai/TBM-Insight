{
  "name": "@tbm-insight/subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "tbm": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "4.4.3",
    "@tbm-insight/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/loader-smoke": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-checkpoint-policy": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/subagent-codex": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-jobs": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}
