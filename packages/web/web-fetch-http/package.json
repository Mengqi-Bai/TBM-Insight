{
  "name": "@tbm-insight/web-fetch-http",
  "description": "Anonymous HTTP(S) fetch provider for the TBM Insight web capability seam (ctx.web)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/web": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/web": "workspace:*",
    "@tbm-insight/http-proxy": "workspace:*"
  }
}
