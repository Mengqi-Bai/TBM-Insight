{
  "name": "@tbm-insight/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the TBM Insight web capability seam (ctx.web)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/deepseek-account": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/llm-deepseek": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/web": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/credentials-local": "workspace:*",
    "@tbm-insight/deepseek-account": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/llm-deepseek": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/web": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/deepseek-account": {
      "optional": true
    }
  }
}
