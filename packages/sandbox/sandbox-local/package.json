{
  "name": "@tbm-insight/sandbox-local",
  "description": "Local process-sandbox backends for the TBM Insight sandbox seam: bwrap, the npm-distributed landlock-run launcher, macOS Seatbelt, or the Windows ACL restricted-token runner — functionally probed, fail-closed",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/session": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/sandbox-windows-acl": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/node-addon-system": "workspace:~",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/session": "workspace:*"
  }
}
