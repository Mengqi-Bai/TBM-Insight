{
  "name": "@tbm-insight/sandbox-policy",
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/session-projection": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/session-projection": "workspace:*"
  }
}
