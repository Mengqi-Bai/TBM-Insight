{
  "name": "@tbm-insight/permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the TBM Insight: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/shell": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/shell": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*"
  }
}
