{
  "name": "@tbm-insight/webhook-github",
  "description": "Signed GitHub HTTP webhook adapter for the TBM Insight webhook runtime",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./examples/*": "./examples/*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "examples/github-review/cordis.yml",
    "examples/github-review/github-ready-review-rule.mjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/host-webserver": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/webhook": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@octokit/webhooks": "^14.2.0"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/host-webserver": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/webhook": "workspace:*"
  }
}
