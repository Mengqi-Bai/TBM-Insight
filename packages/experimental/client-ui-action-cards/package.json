{
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "name": "@tbm-insight/client-ui-action-cards",
  "description": "Action cards below completed answers: the shared card frame, kind bodies and the compact tool row",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "platform": "web",
      "inject": [
        "@tbm-insight/api-remotes",
        "@tbm-insight/client-locale",
        "@tbm-insight/client-ui-conversation",
        "@tbm-insight/client-ui-chat",
        "@tbm-insight/client-ui-session",
        "@tbm-insight/client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/client-ui-renderer": "workspace:*",
    "@tbm-insight/api-remotes": "workspace:*",
    "@tbm-insight/client-locale": "workspace:*",
    "@tbm-insight/client-ui-conversation": "workspace:*",
    "@tbm-insight/client-ui-chat": "workspace:*",
    "@tbm-insight/client-ui-session": "workspace:*",
    "@tbm-insight/client-ui-slots": "workspace:*",
    "@tbm-insight/client-ui-primitives": "workspace:*",
    "@tbm-insight/client-ui-tool": "workspace:*",
    "react": "^18.2.0",
    "@tbm-insight/action-cards": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/client-test-runtime": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
