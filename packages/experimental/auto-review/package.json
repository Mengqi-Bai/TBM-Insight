{
  "name": "@tbm-insight/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the TBM Insight Auto permission preset",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-instructions": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/permission-presets": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/util-values": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-instructions": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/bash-sandbox": "workspace:*",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/fs-observation-policy": "workspace:*",
    "@tbm-insight/fs-sandbox": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/llm-deepseek": "workspace:*",
    "@tbm-insight/llm-deepseek-api-key": "workspace:*",
    "@tbm-insight/permission-presets": "workspace:*",
    "@tbm-insight/ptc-runtime-node": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/shell": "workspace:*",
    "@tbm-insight/shell-env": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-bash": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-fs": "workspace:*",
    "@tbm-insight/tool-subagent": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "tbm": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
