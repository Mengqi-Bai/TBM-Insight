{
  "name": "@tbm-insight/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-alpha.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/action-cards": "workspace:*",
    "@tbm-insight/client-ui-action-cards": "workspace:*",
    "@tbm-insight/creation-recommendations": "workspace:*",
    "@tbm-insight/client-ui-creation-recommendations": "workspace:*",
    "@tbm-insight/plugin-recommendations": "workspace:*",
    "@tbm-insight/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@tbm-insight/cordis-plugin-timer": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/api-remote-access": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/hmr": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/plugin-manager": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/skill": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  },
  "tbm": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
