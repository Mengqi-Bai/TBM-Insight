{
  "name": "@tbm-insight/experimental-browser-use-chrome-devtools-mcp",
  "description": "Experimental per-Session Chromium browser tools through chrome-devtools-mcp",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/experimental-browser-use-runtime": "workspace:*",
    "chrome-devtools-mcp": "1.9.0"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/browser-use": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/browser-use": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  }
}
