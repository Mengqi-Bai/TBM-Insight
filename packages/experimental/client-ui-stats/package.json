{
  "name": "@tbm-insight/experimental-client-ui-stats",
  "description": "Per-turn and per-step context, timing, cache, and tool-cost table contributed as an experimental conversation View",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "tbm": {
    "client": {
      "inject": [
        "@tbm-insight/api-session-controller",
        "@tbm-insight/client-locale",
        "@tbm-insight/client-ui-conversation",
        "@tbm-insight/client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent-team": "workspace:*",
    "@tbm-insight/api-session-controller": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/client-locale": "workspace:*",
    "@tbm-insight/client-store": "workspace:*",
    "@tbm-insight/client-test-runtime": "workspace:*",
    "@tbm-insight/client-ui-conversation": "workspace:*",
    "@tbm-insight/client-ui-primitives": "workspace:*",
    "@tbm-insight/client-ui-renderer": "workspace:*",
    "@tbm-insight/client-ui-session": "workspace:*",
    "@tbm-insight/client-ui-slots": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/llm-retry": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/session-stats": "workspace:*",
    "@tbm-insight/token-meter": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
