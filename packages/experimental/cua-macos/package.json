{
  "name": "@tbm-insight/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/TbmComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/computer-use": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@tbm-insight/atomic-write": "workspace:*",
    "@tbm-insight/cua": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/working-directory": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/attachment-local": "workspace:*",
    "@tbm-insight/computer-use": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/llm-deepseek": "workspace:*",
    "@tbm-insight/ptc-runtime-node": "workspace:*",
    "@tbm-insight/sandbox-local": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/config-editor": "workspace:*",
    "@tbm-insight/hmr": "workspace:*",
    "@tbm-insight/cordis-plugin-timer": "workspace:~",
    "@tbm-insight/storage": "workspace:*",
    "@tbm-insight/storage-json": "workspace:*",
    "@tbm-insight/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
