{
  "name": "@tbm-insight/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/browser-use": "workspace:*",
    "@tbm-insight/mcp-client": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/browser-use": "workspace:*",
    "@tbm-insight/mcp-client": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/mcp-resources": "workspace:*",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/attachment-local": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*"
  }
}
