{
  "name": "@tbm-insight/tool-session-query",
  "description": "Workspace-authorized model-facing session history search, trace, and event read tools",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-query": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-persistence": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/session-query": "workspace:*",
    "@tbm-insight/session-query-sqlite": "workspace:*",
    "@tbm-insight/session-title": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-call-timeout-policy": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  }
}
