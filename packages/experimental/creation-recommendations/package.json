{
  "name": "@tbm-insight/creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/skill": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/plugin-manager": "workspace:*",
    "@tbm-insight/api-remote-access": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/skill": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "resolve.exports": "^2.0.3",
    "zod": "4.4.3",
    "@tbm-insight/client-ui-creation-recommendations": "workspace:*",
    "@tbm-insight/action-cards": "workspace:*",
    "@tbm-insight/client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg"
}
