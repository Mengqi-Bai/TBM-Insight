{
  "name": "@tbm-insight/file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/types/search.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/file-reference": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/file-reference": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/working-directory": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*"
  }
}
