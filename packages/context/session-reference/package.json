{
  "name": "@tbm-insight/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/output-retention": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/session-projection-cache": "workspace:*",
    "@tbm-insight/session-query": "workspace:*",
    "@tbm-insight/session-title": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/spill": {
      "optional": true
    },
    "@tbm-insight/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/compaction": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/output-retention": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/session-projection-cache": "workspace:*",
    "@tbm-insight/session-query": "workspace:*",
    "@tbm-insight/session-query-sqlite": "workspace:*",
    "@tbm-insight/session-title": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/spill-local": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-fs": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  }
}
