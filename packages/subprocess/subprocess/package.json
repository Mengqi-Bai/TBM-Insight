{
  "name": "@tbm-insight/subprocess",
  "description": "Subprocess seam (ctx.subprocess) for the TBM Insight — managed process groups, bounded spill-backed output, and escalated kills behind one abstract service",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./control": {
      "types": "./lib/types/control.d.ts",
      "default": "./lib/control.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/control.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/http-proxy": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/http-proxy": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*"
  }
}
