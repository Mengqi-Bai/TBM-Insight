{
  "name": "@tbm-insight/deepseek-account",
  "description": "Read account state and resolve official API credentials",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/util-values": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/agent": {
      "optional": true
    }
  }
}
