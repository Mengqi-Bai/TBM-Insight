{
  "name": "@tbm-insight/credentials-local",
  "description": "File-backed credentials provider ($TBM_ENGINE_HOME/.env under the live process environment) for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/atomic-write": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/home-paths": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@tbm-insight/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tbm-insight/atomic-write": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/home-paths": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
