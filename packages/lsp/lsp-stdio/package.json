{
  "name": "@tbm-insight/lsp-stdio",
  "description": "Generic stdio language-server provider for the TBM Insight LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/lsp": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/lsp": "workspace:*",
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/subprocess-local": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
