{
  "name": "@tbm-insight/shell",
  "description": "Abstract bash executor seam (ctx.shell) for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/subprocess": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
