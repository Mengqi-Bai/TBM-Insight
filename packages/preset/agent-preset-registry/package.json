{
  "name": "@tbm-insight/agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "zod": "4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@tbm-insight/cordis-plugin-group": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/atomic-write": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/fs-local": "workspace:*",
    "@tbm-insight/hmr": "workspace:*",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/sandbox": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/agent-preset": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
