{
  "name": "@tbm-insight/agent-preset",
  "description": "Declare an Agent capability composition in Cordis YAML",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "skills",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent-preset-registry": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent-preset-registry": "workspace:*",
    "@tbm-insight/compaction-tool-result-pruner": "workspace:*",
    "@tbm-insight/skill": "workspace:*",
    "@tbm-insight/skill-filesystem": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2"
  }
}
