{
  "name": "@tbm-insight/agent-tool-presentation",
  "description": "Deprecated tool presentation selector; use tbm-tool-executor-native or tbm-tool-executor-ptc directly",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
