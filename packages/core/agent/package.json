{
  "name": "@tbm-insight/agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the TBM Insight",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/workspace": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/typert-protocol": "workspace:*",
    "@tbm-insight/typert-registry": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/workspace": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "zod": "4.4.3"
  }
}
