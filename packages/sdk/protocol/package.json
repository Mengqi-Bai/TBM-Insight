{
  "name": "@tbm-insight/sdk-protocol",
  "description": "Shared wire protocol for the TBM Insight SDK runtime: the newline-delimited JSON-RPC stdio transport and the named request, result, and notification types spoken between the runtime server and SDK clients",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/user-questions": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/user-questions": "workspace:*"
  }
}
