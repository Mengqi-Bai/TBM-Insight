{
  "name": "@tbm-insight/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process TBM Insight SDK clients",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/goal": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/llm-deepseek-api-key": "workspace:*",
    "@tbm-insight/schedule": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/sdk-protocol": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/command-compact": "workspace:*",
    "@tbm-insight/command-goal": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/compaction-basic": "workspace:*",
    "@tbm-insight/goal": "workspace:*",
    "@tbm-insight/goal-round-driver": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/llm-deepseek-api-key": "workspace:*",
    "@tbm-insight/permission-presets": "workspace:*",
    "@tbm-insight/plan-mode": "workspace:*",
    "@tbm-insight/sandbox-policy": "workspace:*",
    "@tbm-insight/schedule": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/sdk-protocol": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-persistence-jsonl": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/shell": "workspace:*",
    "@tbm-insight/subagent": "workspace:*",
    "@tbm-insight/token-meter": "workspace:*",
    "@tbm-insight/tool-goal": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/user-approval": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/working-directory": "workspace:*"
  }
