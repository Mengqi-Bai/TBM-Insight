{
  "name": "@tbm-insight/sdk-client",
  "description": "TypeScript client SDK for driving a TBM Insight runtime subprocess over stdio JSON-RPC: the TbmInsight high-level turns API and the lower-level HarnessClient",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/cli": "workspace:*"
  },
  "peerDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sdk-protocol": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/sdk-protocol": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/experimental-translator": "workspace:*"
  }
}
