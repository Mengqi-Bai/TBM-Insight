{
  "name": "@tbm-insight/tool-cordis",
  "description": "Read-only runtime API inspection for Harness plugin development",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/types/host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./host/locale/*.json": "./locale/host/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/host/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/cordis-host-runner": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-group": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/cordis-host-runner": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  }
}
