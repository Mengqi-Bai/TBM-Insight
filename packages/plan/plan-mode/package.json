{
  "name": "@tbm-insight/plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-loop": "workspace:*",
    "@tbm-insight/ptc-runtime": "workspace:*",
    "@tbm-insight/commands": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*",
    "@tbm-insight/system-prompt": "workspace:*",
    "@tbm-insight/tool-executor-native": "workspace:*",
    "@tbm-insight/tool-executor-ptc": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*",
    "@tbm-insight/user-questions": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/agent-loop-testkit": "workspace:*"
  }
}
