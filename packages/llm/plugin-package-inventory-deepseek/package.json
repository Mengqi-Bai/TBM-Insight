{
  "name": "@tbm-insight/plugin-package-inventory-deepseek",
  "description": "Active Loader-backed plugin package inventory for official DeepSeek LLM API requests",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-preset-registry": "workspace:*",
    "@tbm-insight/deepseek-llm-api-extensions": "workspace:*",
    "@tbm-insight/session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tbm-insight/app-boot": "workspace:*",
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent": "workspace:*",
    "@tbm-insight/agent-preset-registry": "workspace:*",
    "@tbm-insight/deepseek-llm-api-extensions": "workspace:*",
    "@tbm-insight/scope": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/session-projection": "workspace:*"
  }
}
