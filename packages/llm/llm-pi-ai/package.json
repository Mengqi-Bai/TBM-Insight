{
  "name": "@tbm-insight/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the TBM Insight LLM seam (design-verification twin of tbm-llm-deepseek)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/authorization": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/timeout": "workspace:*"
  },
  "dependencies": {
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/util-values": "workspace:*",
    "@tbm-insight/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@tbm-insight/cordis": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/agent-loop-testkit": "workspace:*",
    "@tbm-insight/attachment": "workspace:*",
    "@tbm-insight/authorization": "workspace:*",
    "@tbm-insight/credentials": "workspace:*",
    "@tbm-insight/fs": "workspace:*",
    "@tbm-insight/http-proxy": "workspace:*",
    "@tbm-insight/launch-environment": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/llm-deepseek": "workspace:*",
    "@tbm-insight/llm-deepseek-api-key": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/settings": "workspace:*",
    "@tbm-insight/timeout": "workspace:*",
    "@tbm-insight/tool-testkit": "workspace:*",
    "@tbm-insight/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tbm-insight/cordis-plugin-loader": {
      "optional": true
    }
  }
}
