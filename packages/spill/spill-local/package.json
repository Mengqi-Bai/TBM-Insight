{
  "name": "@tbm-insight/spill-local",
  "description": "Local-filesystem implementation of the TBM Insight spill storage seam (private session-scoped files)",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  },
  "dependencies": {
    "@tbm-insight/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@tbm-insight/cordis-plugin-include": "workspace:~",
    "@tbm-insight/cordis-plugin-loader": "workspace:~",
    "@tbm-insight/brand": "workspace:*",
    "@tbm-insight/llm": "workspace:*",
    "@tbm-insight/session": "workspace:*",
    "@tbm-insight/spill": "workspace:*",
    "@tbm-insight/cordis": "workspace:~"
  }
}
